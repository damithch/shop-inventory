# Postgres connection string. On Supabase use the "Transaction pooler" string
# (Connect > Transaction pooler, port 6543), with your DB password filled in.
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Set to false only for a local Postgres without SSL.
DATABASE_SSL=true
# The password the shop owner types into the app.
ADMIN_PASSWORD=change-me
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# How long a login lasts before the app asks again.
TOKEN_TTL=30d
